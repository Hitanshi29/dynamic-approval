<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="mail_template_approval_refused" model="mail.template">
            <field name="name">Approval: Cancelled</field>
            <field name="model_id" ref="model_approval_request"/>
            <field name="subject">Approval Request Cancelled: {{ object.title or object.name }}</field>
            <field name="email_to">{{ object.request_by.email }}</field>
            <field name="body_html" type="html">
                <div>
                    <p>
                        Dear <t t-out="object.request_by.name"/>,
                    </p>

                    <p>
                        Your approval request
                        <strong><t t-out="object.title or object.name"/></strong>
                        has been <strong>cancelled</strong> by
                        <strong><t t-out="user.name"/></strong>.
                    </p>

                    <p>
                        <strong>Request:</strong>
                        <t t-out="object.title or object.name"/>
                    </p>

                    <!-- <p t-if="object.reason">
                        <strong>Reason:</strong>
                        <t t-out="object.reason"/>
                    </p> -->

                    <p>
                        You may review the request and submit it again if necessary.
                    </p>

                    <p>
                        Thank you.
                    </p>
                </div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>
    </data>
</odoo>