<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="mail_template_approval_step_assigned" model="mail.template">
            <field name="name">Approval: Step Assigned</field>
            <field name="model_id" ref="model_approval_request"/>
            <field name="subject">Approval Request: {{ object.title or object.name }}</field>
            <field name="email_to">{{ object.approver_id.email }}</field>
            <field name="body_html" type="html">
                <div style="font-family: Arial, sans-serif; font-size: 14px; color: #333;">
                    <p>Dear Approver,</p>

                    <p>
                        A new approval request has been submitted and is awaiting your review.
                    </p>

                    <table style="border-collapse: collapse; margin: 15px 0;">
                        <tr>
                            <td style="padding: 6px 10px;"><strong>Request</strong></td>
                            <td style="padding: 6px 10px;">
                                <t t-out="object.title or object.name"/>
                            </td>
                        </tr>

                        <tr t-if="object.request_by">
                            <td style="padding: 6px 10px;"><strong>Requested By</strong></td>
                            <td style="padding: 6px 10px;">
                                <t t-out="object.request_by.name"/>
                            </td>
                        </tr>

                        <tr t-if="object.line_ids">
                            <td style="padding: 6px 10px;"><strong>Approval Step</strong></td>
                            <td style="padding: 6px 10px;">
                                <t t-out="(object.line_ids.filtered(lambda l: l.state == 'to_approve')[:1]).title or ''"/>
                            </td>
                        </tr>

                        <tr>
                            <td style="padding: 6px 10px;"><strong>Status</strong></td>
                            <td style="padding: 6px 10px;">Waiting for Approval</td>
                        </tr>
                    </table>

                    <p>
                        Please review this request at your earliest convenience and take the appropriate action.
                    </p>

                    <p>
                        Thank you,<br/>
                        <strong><t t-out="user.company_id.name"/></strong>
                    </p>
                </div>
            </field>
        </record>
    </data>

</odoo>