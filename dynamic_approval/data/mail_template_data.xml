<odoo noupdate="1">
    <record id="mail_template_approval_step_assigned" model="mail.template">
        <field name="name">Approval: Step Assigned</field>
        <field name="model_id" ref="model_approval_request"/>
        <field name="subject">Approval needed: {{ object.name }}</field>
        <field name="email_to">{{ object.approver_id.email }}</field>
        <field name="body_html" type="html">
            <p>
                You have an approval request waiting: <strong t-out="object.title or object.name"/>.
            </p>
            <p t-if="object.line_ids">
                Step: <strong t-out="(object.line_ids.filtered(lambda l: l.state == 'to_approve')[:1]).title or ''"/>
            </p>
        </field>
    </record>

    <record id="mail_template_approval_approved" model="mail.template">
        <field name="name">Approval: Fully Approved</field>
        <field name="model_id" ref="model_approval_request"/>
        <field name="subject">Approved: {{ object.name }}</field>
        <field name="email_to">{{ object.request_by.email }}</field>
        <field name="body_html" type="html">
            <p>
                Your request <strong t-out="object.title or object.name"/> has been fully approved.
            </p>
        </field>
    </record>

    <record id="mail_template_approval_refused" model="mail.template">
        <field name="name">Approval: Cancelled</field>
        <field name="model_id" ref="model_approval_request"/>
        <field name="subject">Cancelled: {{ object.name }}</field>
        <field name="email_to">{{ object.request_by.email }}</field>
        <field name="body_html" type="html">
            <p>
                Your request <strong t-out="object.title or object.name"/> has been cancelled.
            </p>
        </field>
    </record>
    
</odoo>