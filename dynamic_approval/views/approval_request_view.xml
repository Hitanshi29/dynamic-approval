<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_approval_request_form" model="ir.ui.view">
        <field name="name">approval.request.form</field>
        <field name="model">approval.request</field>
        <field name="arch" type="xml">
            <form string="Approval Request">
                <header>
                    
                    <button name="action_submit" string="Submit" type="object"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state != 'draft'"/>

                   
                    <button name="action_approve" string="Approve" type="object"
                            class="oe_highlight"
                            invisible="state != 'submitted' or not is_approver"/>

                    <button name="action_cancel" string="Cancel" type="object"
                            class="oe_highlight" invisible="state != 'submitted' or not is_approver"/>

                    <!-- <widget name="approval_document_uploader"/> -->
                    <button name="action_change_approver" string="Change Approver" type="object"
                            invisible="state != 'submitted'" groups="dynamic_approval.group_access_approval_admin"/>

                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,approved,cancel"/>
                </header>
                <sheet>
                    <h1>
                        <field name="name"/>
                    </h1>
                    <div class="oe_title">
                        <label for="title" string="Title"/>
                        <h1>
                            <field name="title" placeholder="Title"
                                   readonly="state != 'draft'"/>
                        </h1>
                    </div>
                    <group>
                        <group class="o_group" name="info_box">
                            <field name="request_by" readonly="state != 'draft'"/>
                            <field name="request_date" readonly="state != 'draft'"/>
                            
                        </group>
                        <group>
                            <field name="allowed_approver_user_ids" invisible="1"/>
                            <field name="type_id" readonly="state != 'draft'"
                                options="{'no_create_edit': True}"/>
                            <field name="deadline" readonly="state != 'draft'"/>
                            
                            <field name="is_approver" invisible="1"/>
                            <field name="res_model" invisible="1"/>
                            <field name="res_id" invisible="1"/>
                        </group>
                    </group>

                 
                    <field name="type_document_opt" invisible="1"/>
                    <field name="type_contact_opt" invisible="1"/>
                    <field name="type_date_opt" invisible="1"/>
                    <field name="type_period_opt" invisible="1"/>
                    <field name="type_item_opt" invisible="1"/>
                    <field name="type_multi_items_opt" invisible="1"/>
                    <field name="type_quantity_opt" invisible="1"/>
                    <field name="type_amount_opt" invisible="1"/>
                    <field name="type_payment_opt" invisible="1"/>
                    <field name="type_reference_opt" invisible="1"/>
                    <field name="type_location_opt" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                    <!-- <field name="has_additional_fields" invisible="1"/> -->

                    <notebook>
                        <page string="Description" name="description">
                            <field name="description" readonly="state != 'draft'"/>
                        </page>

                        <page string="Add Details" name="additional_details"
                              invisible="type_document_opt == 'none' and type_contact_opt == 'none' and type_date_opt == 'none' and type_period_opt == 'none' and type_item_opt == 'none' and type_multi_items_opt == 'none' and type_quantity_opt == 'none' and type_amount_opt == 'none' and type_payment_opt == 'none' and type_reference_opt == 'none' and type_location_opt == 'none'">
                            <group>
                                <group>
                                    <field name="contact_id"
                                           invisible="type_contact_opt == 'none'"
                                           required="type_contact_opt == 'required'"
                                           readonly="state != 'draft'"/>
                                    <field name="date"
                                           invisible="type_date_opt == 'none'"
                                           required="type_date_opt == 'required'"
                                           readonly="state != 'draft'"/>
                                    <label for="date_from" string="Period"
                                           invisible="type_period_opt == 'none'"/>
                                    <div class="o_row" invisible="type_period_opt == 'none'">
                                        <field name="date_from"
                                               required="type_period_opt == 'required'"
                                               readonly="state != 'draft'"/>
                                        <span> - </span>
                                        <field name="date_to"
                                               required="type_period_opt == 'required'"
                                               readonly="state != 'draft'"/>
                                    </div>
                                    <field name="item"
                                           invisible="type_item_opt == 'none'"
                                           required="type_item_opt == 'required'"
                                           readonly="state != 'draft'"/>
                                    <field name="quantity"
                                           invisible="type_quantity_opt == 'none'"
                                           required="type_quantity_opt == 'required'"
                                           readonly="state != 'draft'"/>
                                </group>
                                <group>
                                    <field name="amount"
                                           invisible="type_amount_opt == 'none'"
                                           required="type_amount_opt == 'required'"
                                           readonly="state != 'draft'"/>
                                    <field name="payment_ref" string="Payment"
                                           invisible="type_payment_opt == 'none'"
                                           required="type_payment_opt == 'required'"
                                           readonly="state != 'draft'"/>
                                    <field name="reference"
                                           invisible="type_reference_opt == 'none'"
                                           required="type_reference_opt == 'required'"
                                           readonly="state != 'draft'"/>
                                    <field name="location"
                                           invisible="type_location_opt == 'none'"
                                           required="type_location_opt == 'required'"
                                           readonly="state != 'draft'"/>
                                    <field name="document" filename="document_filename"
                                           invisible="type_document_opt == 'none'"
                                           required="type_document_opt == 'required'"
                                           readonly="state != 'draft'"/>
                                    <field name="document_filename" invisible="1"/>
                                </group>
                            </group>
                            <field name="item_ids"
                                   invisible="type_multi_items_opt == 'none'"
                                   readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="quantity"/>
                                    <field name="amount"/>
                                </list>
                            </field>
                            <!-- Using Product model -->
                            <!-- <field name="item_ids"
                                invisible="type_multi_items_opt == 'none'"
                                readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="name" column_invisible="1"/>
                                    <field name="quantity"/>
                                    <field name="amount"/>
                                </list>
                            </field> -->
                        </page>
                        <page string="Approver Details">
                            <group>
                                <field name="line_ids" invisible="not line_ids" readonly="1">
                                    <list decoration-muted="state in ('waiting',)"
                                        decoration-success="state == 'approved'"
                                        decoration-danger="state == 'refused'"
                                        decoration-info="state == 'to_approve'">
                                        <field name="sequence" widget="handle"/>
                                        <field name="title"/>
                                        <field name="user_id"/>
                                        <field name="minimum_amount"/>
                                        <field name="state" widget="badge"
                                            decoration-success="state == 'approved'"
                                            decoration-info="state == 'to_approve'"
                                            decoration-danger="state == 'refused'"/>
                                        <field name="approved_date"/>
                                    </list>
                                </field>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>


    <record id="view_approval_request_list" model="ir.ui.view">
        <field name="name">approval.request.list</field>
        <field name="model">approval.request</field>
        <field name="arch" type="xml">
            <list string="Approval Requests" decoration-muted="state == 'cancel'">
                <field name="name"/>
                <field name="title"/>
                <field name="type_id"/>
                <field name="request_by"/>
                <field name="approver_id"/>
                <field name="request_date"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'approved'"
                       decoration-info="state == 'submitted'"
                       decoration-warning="state == 'refused'"
                       decoration-danger="state == 'cancel'"/>
            </list>
        </field>
    </record>

    <record id="view_approval_request_kanban" model="ir.ui.view">
        <field name="name">approval.request.kanban</field>
        <field name="model">approval.request</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="title"/>
                <field name="description"/>
                <field name="state"/>
                <field name="type_id"/>
                <field name="request_by"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <!-- <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <field name="priority" widget="priority"/>
                                    </div>
                                </div> -->
                                <div class="text-muted">
                                    <field name="title"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_approval_request_quick_form" model="ir.ui.view">
        <field name="name">approval.request.quick.form</field>
        <field name="model">approval.request</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <form string="Request Approval">
                <sheet>
                    <div class="oe_title">
                        <label for="title" string="Title"/>
                        <h1>
                            <field name="title" placeholder="Title" readonly="state != 'draft'"/>
                        </h1>
                    </div>
                    <group class="o_group" name="info_box">
                        <field name="request_by" readonly="state != 'draft'"/>
                        <field name="request_date" readonly="state != 'draft'"/>
                        <field name="type_id" readonly="state != 'draft'" options="{'no_create_edit': True}"/>
                        <field name="deadline" readonly="state != 'draft'"/>
                        <field name="allowed_approver_user_ids" invisible="1"/>
                        <field name="res_model" invisible="1"/>
                        <field name="res_id" invisible="1"/>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description" readonly="state != 'draft'"/>
                        </page>
                        <page string="Approver Details">
                            <group>
                                <field name="line_ids" invisible="not line_ids" readonly="1">
                                    <list decoration-muted="state in ('waiting',)"
                                        decoration-success="state == 'approved'"
                                        decoration-danger="state == 'refused'"
                                        decoration-info="state == 'to_approve'">
                                        <field name="sequence" widget="handle"/>
                                        <field name="title"/>
                                        <field name="user_id"/>
                                        <field name="minimum_amount"/>
                                        <field name="state" widget="badge"
                                            decoration-success="state == 'approved'"
                                            decoration-info="state == 'to_approve'"
                                            decoration-danger="state == 'refused'"/>
                                        <field name="approved_date"/>
                                    </list>
                                </field>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button name="action_submit" string="Submit" type="object"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>


    <record id="view_approval_request_search" model="ir.ui.view">
        <field name="name">approval.request.search</field>
        <field name="model">approval.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>

                <filter string="My Request"
                        name="my_request"
                        domain="[('request_by', '=', uid)]"/>
                <filter string="My Approvals"
                    name="my_approvals"
                    domain="[('approver_id', '=', uid), ('state', '=', 'approved')]"/>

                <filter string="To Review"
                    name="to_review"
                    domain="[('approver_id', '=', uid), ('state', '=', 'submitted')]"/>

                <!-- <group expand="0" string="Group By">
                    <filter name="group_state"
                            string="Status"
                            context="{'group_by': 'state'}"/>
                </group> -->

            </search>
        </field>
    </record>

    <record id="action_approval_request_my" model="ir.actions.act_window">
        <field name="name">Approvals</field>
        <field name="res_model">approval.request</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_approval_request_search"/>
        <field name="context">{'search_default_to_review': 1}</field>
    </record>

    <record id="action_approval_request_to_approve" model="ir.actions.act_window">
        <field name="name">My Requests</field>
        <field name="res_model">approval.request</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_approval_request_search"/>
        <field name="context">{'search_default_my_request': 1}</field>
    </record>
</odoo>