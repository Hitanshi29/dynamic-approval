<odoo>

    <record id="res_config_settings_set_amount" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.sale</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="10"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block" position="inside">
                <setting help="Request Managers to approve orders above a minimum amount">
                    <field name="set_amount"/>
                    <div invisible="set_amount != True">
                        <label for="minimum_amount"/>
                        <field name="minimum_amount"/>
                    </div>
                </setting>
            </xpath>
        
        </field>
    </record>
</odoo>