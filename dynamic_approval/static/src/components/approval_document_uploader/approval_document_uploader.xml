<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="approval_document_uploader.ApprovalDocumentUploader">
        <div class="o_approval_document_uploader d-flex align-items-center">
            <button type="button"
                    class="btn btn-secondary d-flex align-items-center gap-1"
                    t-on-click="onUploadClick">
                <i class="fa fa-paperclip" role="img" aria-label="Attach"/>
                <span>Attach Document</span>
            </button>
            <input type="file"
                   t-ref="fileInput"
                   class="d-none"
                   multiple="multiple"
                   t-on-change="onFileChange"/>
        </div>
    </t>

</templates>