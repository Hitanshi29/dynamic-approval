<odoo>

    <record id="checklist_form" model="ir.ui.view">
        <field name="name">checklist.template.form</field>
        <field name="model">checklist.template</field>
        <field name="arch" type="xml">
            <form string="Checklist Template">
                <group>
                    <field name="name"/>
                    <field name="checklist_type"/>
                    <field name="line_ids"/>
                </group>
            </form>
        </field>
    </record>

    <record id="checklist_list" model="ir.ui.view">
        <field name="name">checklist.template.list</field>
        <field name="model">checklist.template</field>
        <field name="arch" type="xml">
            <list string="Checklist Template">
                <field name="name"/>
                <field name="line_ids" widget="one2many_tags"/>
            </list>
        </field>
    </record>

    <record id="action_qa_checklist" model="ir.actions.act_window">
        <field name="name">QA Checklist Template</field>
        <field name="res_model">checklist.template</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('checklist_type','=','qa_template')]</field>
        <field name="context">{'default_checklist_type':'qa_template'}</field>
    </record>

     <record id="action_survey_checklist" model="ir.actions.act_window">
        <field name="name">Survey Checklist Template</field>
        <field name="res_model">checklist.template</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('checklist_type','=','survey_template')]</field>
        <field name="context">{'default_checklist_type':'survey_template'}</field>
    </record>

</odoo>